# Set these in Coolify. Do not commit real values.
NODE_ENV=production
PORT=5000
DATABASE_URL=postgresql://USER:PASSWORD@POSTGRES_INTERNAL_HOST:5432/classifieds?schema=public
JWT_SECRET=generate-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=1d
FRONTEND_ORIGIN=https://classifieds.videxpulse.com
COOKIE_SECURE=true
N8N_LISTING_WEBHOOK_URL=https://n8n.videxpulse.com/webhook/classifieds-listing
N8N_WEBHOOK_SECRET=replace-with-a-secret-shared-with-n8n
INTERNAL_API_URL=http://classifieds-api:5000
